    "main": "index.js",
    "scripts": {
        "export": "zip -r quizhunt.zip . -x \"./.git/*\"",
        "list": "node -e \"require('./index').handler({path: '/api/blog', headers: { origin: 'https://spencer.carvers.info' }, requestContext: {} }).then(console.log);\"",
